<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Rememory.Views.Clipboard.ClipboardRootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Rememory.Views.Clipboard"
      xmlns:models="using:Rememory.Models"
      xmlns:tk="using:CommunityToolkit.WinUI"
      xmlns:tkanimations="using:CommunityToolkit.WinUI.Animations"
      xmlns:tkconverters="using:CommunityToolkit.WinUI.Converters"
      xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
      xmlns:converters="using:Rememory.Converters"
      xmlns:helper="using:Rememory.Helper"
      xmlns:controls="using:Rememory.Views.Clipboard.Controls"
      xmlns:behavior="using:Rememory.Views.Clipboard.Controls.Behavior"
      xmlns:selector="using:Rememory.Views.Clipboard.Controls.Selector"
      x:Name="RootPage"
      DataContext="{x:Bind ViewModel, Mode=OneTime}"
      KeyDown="RootPage_KeyDown">
    <Page.Resources>
        <tkconverters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"
                                                TrueValue="Collapsed"
                                                FalseValue="Visible" />
        <converters:ClipDataDictionaryToDataConverter x:Key="ClipDataDictionaryToDataConverter" />
        <converters:DateTimeToHumanReadableConverter x:Key="DateTimeToHumanReadableConverter" />
        <converters:DataFooterInfoConverter x:Key="DataFooterInfoConverter" />

        <tkanimations:ImplicitAnimationSet x:Name="ShowTransitionsAnimation">
            <tkanimations:TranslationAnimation EasingMode="EaseOut"
                                               From="0,-20,0"
                                               To="0"
                                               Duration="0:0:0.4" />
            <tkanimations:OpacityAnimation EasingMode="EaseOut"
                                           From="0"
                                           To="1"
                                           Duration="0:0:0.4" />
        </tkanimations:ImplicitAnimationSet>

        <selector:NavigationTabTemplateSelector x:Key="NavigationTabTemplateSelector"
                                                TabItemTemplate="{StaticResource TabItemTemplate}"
                                                TagTabItemTemplate="{StaticResource TagTabItemTemplate}" />

        <MenuFlyout x:Key="TitleBarContextMenuFlyout">
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_PinWindow"
                            AccessKey="T"
                            Command="{x:Bind ViewModel.ToggleWindowPinnedCommand}"
                            IsEnabled="{x:Bind ViewModel.IsWindowPinned, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE718;}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="T"
                                         Modifiers="Control" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_UnpinWindow"
                            AccessKey="U"
                            Command="{x:Bind ViewModel.ToggleWindowPinnedCommand}"
                            IsEnabled="{x:Bind ViewModel.IsWindowPinned, Mode=OneWay}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE77A;}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="T"
                                         Modifiers="Control" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_PauseMonitoring"
                            AccessKey="P"
                            Command="{x:Bind ViewModel.ToggleClipboardMonitoringEnabledCommand}"
                            IsEnabled="{x:Bind ViewModel.IsClipboardMonitoringEnabled, Mode=OneWay}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xF0E3;}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M"
                                         Modifiers="Control" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_ResumeMonitoring"
                            AccessKey="R"
                            Command="{x:Bind ViewModel.ToggleClipboardMonitoringEnabledCommand}"
                            IsEnabled="{x:Bind ViewModel.IsClipboardMonitoringEnabled, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xF0E3;}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M"
                                         Modifiers="Control" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_Settings"
                            AccessKey="S"
                            Command="{x:Bind ViewModel.OpenSettingsWindowCommand}"
                            Icon="{tk:FontIcon Glyph=&#xE713;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/TitleBarMenu_Exit"
                            AccessKey="E"
                            Command="{x:Bind ViewModel.ExitAppCommand}"
                            Icon="{tk:FontIcon Glyph=&#xEA39;}" />
        </MenuFlyout>

        <Flyout x:Key="FilterButtonFlyout"
                ShouldConstrainToRootBounds="False">
            <Flyout.FlyoutPresenterStyle>
                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                       TargetType="FlyoutPresenter">
                    <Setter Property="MaxHeight"
                            Value="500" />
                    <Setter Property="Background"
                            Value="Transparent" />
                </Style>
            </Flyout.FlyoutPresenterStyle>

            <Flyout.SystemBackdrop>
                <DesktopAcrylicBackdrop />
            </Flyout.SystemBackdrop>

            <TreeView x:Name="FilterTreeView"
                      SelectionMode="Multiple"
                      CanDragItems="False"
                      CanReorderItems="False"
                      ItemsSource="{x:Bind ViewModel.AppTreeViewNodes, Mode=OneWay}"
                      ItemTemplate="{StaticResource AppTreeViewNodeTemplate}"
                      Loaded="FilterTreeView_Loaded"
                      Unloaded="FilterTreeView_Unloaded"
                      SelectionChanged="FilterTreeView_SelectionChanged" />
        </Flyout>

        <Flyout x:Key="EraseButtonFlyout"
                x:Name="EraseButtonFlyout"
                ShouldConstrainToRootBounds="False">
            <Grid MaxWidth="260"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="/Clipboard/EraseData_FlyoutHeader"
                           Grid.Row="0"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyLargeStrongTextBlockStyle}" />

                <TextBlock x:Uid="/Clipboard/EraseData_FlyoutDescription"
                           Grid.Row="1"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}" />

                <CheckBox x:Uid="/Resources/DoNotShowAgainCheckbox"
                          Grid.Row="2"
                          HorizontalAlignment="Left"
                          IsChecked="{x:Bind ViewModel.SettingsContext.SkipWarningMessageOnMainWindowClipsErase, Mode=TwoWay}" />

                <Button x:Uid="/Clipboard/EraseData_FlyoutButton"
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="EraseFlyoutButton_Click" />
            </Grid>
        </Flyout>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          CornerRadius="0"
          Background="{x:Bind ViewModel.SettingsContext.WindowBackgroundBrush, Mode=OneWay}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PinnedWindowState">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind ViewModel.IsWindowPinned, Mode=OneWay}"
                                                To="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.BorderThickness"
                                Value="0" />
                        <Setter Target="PinnedWindowBorder.Visibility"
                                Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="RoundedCornerState">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind _window.IsRoundedCornerSupported, Mode=OneTime}"
                                                To="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.CornerRadius"
                                Value="7" />
                        <Setter Target="PinnedWindowBorder.CornerRadius"
                                Value="7" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="NoneSelectionMode">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind MultiSelectionToggleButton.IsChecked, Mode=OneWay}"
                                                To="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ClipsListViewControl.SelectionMode"
                                Value="None" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="MultipleSelectionMode">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind MultiSelectionToggleButton.IsChecked, Mode=OneWay}"
                                                To="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ClipsListViewControl.SelectionMode"
                                Value="Multiple" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView x:Name="NavigationTabView"
                        IsPaneOpen="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="LeftCompact"
                        MenuItemTemplateSelector="{StaticResource NavigationTabTemplateSelector}"
                        SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                        MenuItemsSource="{x:Bind ViewModel.NavigationTabItems, Mode=OneWay}"
                        KeyDown="NavigationTabList_KeyDown">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewPaneContentGridMargin">-1,2,-1,2</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0,0,0,0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewContentBackground">Transparent</SolidColorBrush>
            </NavigationView.Resources>

            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"
                                          MinWidth="50" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="WindowCaptionBorder"
                            Grid.Column="0">
                        <TextBlock Margin="8,10,0,10"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Text="{x:Bind ViewModel.SelectedTab.Title, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Uid="/Clipboard/TitleBar_MoreButton"
                                AutomationProperties.AutomationId="TitleBarButtons"
                                AutomationProperties.Name="More"
                                AccessKey="M"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Content="{tk:FontIcon FontSize=14, Glyph=&#xE712;}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Flyout="{StaticResource TitleBarContextMenuFlyout}" />

                        <Button x:Uid="/Clipboard/TitleBar_CloseButton"
                                AutomationProperties.AutomationId="TitleBarButtons"
                                AutomationProperties.Name="Close Window"
                                AccessKey="C"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Command="{x:Bind ViewModel.CloseWindowCommand}"
                                Content="{tk:FontIcon FontSize=14, Glyph=&#xE711;}"
                                Style="{StaticResource SubtleButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="/Clipboard/SearchBox"
                                    AutomationProperties.AutomationId="SearchBox"
                                    AutomationProperties.Name="Search Clips"
                                    Grid.Column="0"
                                    TabIndex="2"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.IsSearchEnabled, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewKeyDown="SearchBox_PreviewKeyDown" />

                    <Grid Grid.Column="1"
                          Width="32"
                          Margin="4,0,0,0"
                          VerticalAlignment="Stretch">
                        <Button x:Name="FilterButton"
                                x:Uid="/Clipboard/FilterButton"
                                AutomationProperties.AutomationId="FilterButton"
                                AutomationProperties.Name="Filter Clips"
                                AccessKey="F"
                                TabIndex="3"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{tk:FontIcon FontSize=14, Glyph=&#xE71C;}"
                                Flyout="{StaticResource FilterButtonFlyout}" />
                        <InfoBadge x:Name="FilterButtonBadge"
                                   x:Load="{x:Bind ViewModel.IsFilterApplied, Mode=OneWay}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource AttentionDotInfoBadgeStyle}" />
                    </Grid>

                    <Rectangle Grid.Column="2"
                               Width="1"
                               Height="16"
                               Margin="4,0,0,0"
                               Fill="{ThemeResource ButtonBorderThemeBrush}" />

                    <Button x:Name="EraseButton"
                            x:Uid="/Clipboard/EraseButton"
                            AutomationProperties.AutomationId="EraseButton"
                            AutomationProperties.Name="Erase Clips"
                            AccessKey="E"
                            Grid.Column="3"
                            TabIndex="4"
                            Width="32"
                            Margin="4,0,0,0"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ShowEraseButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Content="{tk:FontIcon FontSize=14, Glyph=&#xE75C;}"
                            Click="EraseButton_Click" />

                    <ToggleButton x:Name="MultiSelectionToggleButton"
                                  x:Uid="/Clipboard/MultiSelectionButton"
                                  AutomationProperties.AutomationId="MultiSelectionButton"
                                  AutomationProperties.Name="Enable Multiple Selection"
                                  AccessKey="S"
                                  Grid.Column="4"
                                  TabIndex="5"
                                  Width="32"
                                  Margin="4,0,0,0"
                                  Padding="0"
                                  VerticalAlignment="Stretch"
                                  Content="{tk:FontIcon FontSize=14, Glyph=&#xE762;}" />
                </Grid>

                <Grid x:Name="MonitoringPausedBanner"
                      Grid.Row="2"
                      Margin="0,0,0,8"
                      Padding="8"
                      ColumnSpacing="8"
                      CornerRadius="{ThemeResource ControlCornerRadius}"
                      BorderBrush="{ThemeResource InfoBarBorderBrush}"
                      BorderThickness="{ThemeResource InfoBarBorderThickness}"
                      Background="{ThemeResource InfoBarWarningSeverityBackgroundBrush}"
                      tkanimations:Implicit.ShowAnimations="{StaticResource ShowTransitionsAnimation}"
                      Visibility="{x:Bind ViewModel.IsClipboardMonitoringEnabled, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Margin="4,0,0,0"
                              FontSize="16"
                              Glyph="&#xF167;"
                              Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}" />

                    <TextBlock x:Uid="/Clipboard/PauseMonitoringBanner"
                               Grid.Column="1"
                               TextWrapping="Wrap" />
                </Grid>

                <controls:ClipsListView x:Name="ClipsListViewControl"
                                        Grid.Row="3"
                                        Margin="0,0,-12,0"
                                        TabIndex="1"
                                        ShowInCompactMode="{x:Bind ViewModel.SettingsContext.IsCompactViewEnabled, Mode=OneWay}"
                                        ViewModel="{x:Bind ViewModel, Mode=OneTime}"
                                        RequestSearchBoxFocus="ClipsListView_RequestSearchBoxFocus"
                                        RequestNavigationTabViewFocus="ClipsListView_RequestNavigationTabViewFocus" />
            </Grid>
        </NavigationView>

        <Border x:Name="PinnedWindowBorder"
                BorderThickness="2"
                BorderBrush="{ThemeResource SystemAccentColor}"
                Visibility="Collapsed" />
    </Grid>
</Page>
