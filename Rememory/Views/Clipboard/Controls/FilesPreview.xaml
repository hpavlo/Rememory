<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.FilesPreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       xmlns:tk="using:CommunityToolkit.WinUI"
                       x:Name="ParentControl"
                       Loaded="ParentControl_Loaded">
    <local:DataPreviewBase.Resources>
        <x:Double x:Key="FilePreviewImageSize">16</x:Double>
    </local:DataPreviewBase.Resources>

    <Grid>
        <ListView x:Name="FilesListView"
                  SelectionMode="None"
                  IsHitTestVisible="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind Files, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight"
                            Value="{StaticResource FilePreviewImageSize}" />
                    <Setter Property="IsTabStop"
                            Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter x:Name="FilePresenter"
                                                  MinHeight="{StaticResource FilePreviewImageSize}"
                                                  Padding="{Binding FilePresenterPadding, ElementName=ParentControl}"
                                                  FontSize="{StaticResource StandardViewTextFontSize}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="InvalidFilePath">
                                                <VisualState.StateTriggers>
                                                    <tk:IsEqualStateTrigger Value="{Binding IsPathCorrect}"
                                                                            To="False" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="FilePresenter.Opacity"
                                                            Value="0.5" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>

                                        <VisualStateGroup>
                                            <VisualState x:Name="CompactMode">
                                                <VisualState.StateTriggers>
                                                    <StateTrigger IsActive="{Binding ShowInCompactMode}" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="FilePresenter.Padding"
                                                            Value="0,1,0,1" />
                                                    <Setter Target="FilePresenter.FontSize"
                                                            Value="{StaticResource CompactViewTextFontSize}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FilePreviewModel"
                              x:DefaultBindMode="OneWay">
                    <Grid x:Name="RootGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="FileImage"
                               x:Load="{x:Bind ImageSource, Converter={StaticResource EmptyObjectToBoolConverter}}"
                               Grid.Column="0"
                               Width="{StaticResource FilePreviewImageSize}"
                               Height="{StaticResource FilePreviewImageSize}"
                               Margin="0,0,8,0"
                               Source="{x:Bind ImageSource}" />

                        <TextBlock Grid.Column="1"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="{Binding TextWrapping, ElementName=ParentControl}"
                                   IsTextSelectionEnabled="{Binding IsTextSelectionEnabled, ElementName=ParentControl}"
                                   Text="{x:Bind DisplayText, Mode=OneTime}" />

                        <TextBlock x:Name="RightSizeText"
                                   x:Load="{x:Bind RightSideInfo, Converter={StaticResource EmptyObjectToBoolConverter}}"
                                   Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Opacity="0.5"
                                   Text="{x:Bind RightSideInfo}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:DataPreviewBase>
