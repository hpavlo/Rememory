<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.EmptyPreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       x:Name="ParentControl"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Loaded="ParentControl_Loaded">
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactView">
                    <VisualState.Setters>
                        <Setter Target="EmptyPreviewIcon.FontSize"
                                Value="14" />
                        <Setter Target="EmptyPreviewText.FontSize"
                                Value="{StaticResource CompactViewTextFontSize}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="StandardView">
                    <VisualState.Setters>
                        <Setter Target="EmptyPreviewIcon.FontSize"
                                Value="16" />
                        <Setter Target="EmptyPreviewText.FontSize"
                                Value="{StaticResource StandardViewTextFontSize}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ExpandedView" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <FontIcon x:Name="EmptyPreviewIcon"
                  Glyph="&#xE9CE;" />

        <TextBlock x:Name="EmptyPreviewText"
                   x:Uid="/Clipboard/Clip_NoPreview"
                   Style="{StaticResource BodyTextBlockStyle}" />
    </StackPanel>
</local:DataPreviewBase>
