<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.LinkPreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       xmlns:tk="using:CommunityToolkit.WinUI"
                       xmlns:tkconverters="using:CommunityToolkit.WinUI.Converters"
                       x:Name="ParentControl"
                       Loaded="ParentControl_Loaded"
                       Unloaded="ParentControl_Unloaded">
    <local:DataPreviewBase.Resources>
        <tkconverters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
        <x:Double x:Key="LinkPreviewStandardViewMaxHeight">94</x:Double>
        <x:Double x:Key="LinkPreviewStandardViewImageSize">92</x:Double>
    </local:DataPreviewBase.Resources>

    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- The explicit reset state -->
                <VisualState x:Name="BaseView" />

                <VisualState x:Name="LinkMetadataNotAvailable">
                    <VisualState.Setters>
                        <Setter Target="PreviewUrl.MaxLines"
                                Value="6" />
                        <Setter Target="PreviewUrl.FontSize"
                                Value="{StaticResource StandardViewTextFontSize}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="CompactView">
                    <VisualState.Setters>
                        <Setter Target="PreviewUrl.MaxLines"
                                Value="1" />
                        <Setter Target="PreviewUrl.FontSize"
                                Value="{StaticResource CompactViewTextFontSize}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="StandardView">
                    <VisualState.Setters>
                        <Setter Target="PreviewUrl.MaxLines"
                                Value="2" />
                        <Setter Target="PreviewUrl.FontSize"
                                Value="{StaticResource StandardViewTextFontSize}" />

                        <Setter Target="PreviewGrid.Margin"
                                Value="0,8,0,0" />
                        <Setter Target="PreviewGrid.MaxHeight"
                                Value="{StaticResource LinkPreviewStandardViewMaxHeight}" />

                        <Setter Target="PreviewImageBorder.(Grid.RowSpan)"
                                Value="2" />
                        <Setter Target="PreviewImageBorder.Width"
                                Value="{StaticResource LinkPreviewStandardViewImageSize}" />
                        <Setter Target="PreviewImageBorder.Height"
                                Value="{StaticResource LinkPreviewStandardViewImageSize}" />
                        <Setter Target="PreviewImageBorder.CornerRadius"
                                Value="4,0,0,4" />

                        <Setter Target="PreviewImage.Stretch"
                                Value="UniformToFill" />

                        <Setter Target="PreviewTitle.(Grid.Column)"
                                Value="1" />
                        <Setter Target="PreviewTitle.Margin"
                                Value="8,4,8,4" />
                        <Setter Target="PreviewTitle.MaxLines"
                                Value="2" />
                        <Setter Target="PreviewTitle.Style"
                                Value="{StaticResource BodyStrongTextBlockStyle}" />

                        <Setter Target="PreviewDescription.(Grid.Column)"
                                Value="1" />
                        <Setter Target="PreviewDescription.(Grid.Row)"
                                Value="1" />
                        <Setter Target="PreviewDescription.Margin"
                                Value="8,0,8,4" />
                        <Setter Target="PreviewDescription.VerticalAlignment"
                                Value="Top" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ExpandedView">
                    <VisualState.Setters>
                        <Setter Target="PreviewUrl.FontSize"
                                Value="{StaticResource ExpandedViewTextFontSize}" />

                        <Setter Target="PreviewGrid.Margin"
                                Value="0,16,0,0" />

                        <Setter Target="PreviewImageBorder.(Grid.Column)"
                                Value="1" />
                        <Setter Target="PreviewImageBorder.CornerRadius"
                                Value="4,4,0,0" />

                        <Setter Target="PreviewTitle.(Grid.Column)"
                                Value="1" />
                        <Setter Target="PreviewTitle.(Grid.Row)"
                                Value="1" />
                        <Setter Target="PreviewTitle.Margin"
                                Value="8,16,8,16" />
                        <Setter Target="PreviewTitle.Style"
                                Value="{StaticResource BodyLargeStrongTextBlockStyle}" />

                        <Setter Target="PreviewDescription.(Grid.Column)"
                                Value="1" />
                        <Setter Target="PreviewDescription.(Grid.Row)"
                                Value="2" />
                        <Setter Target="PreviewDescription.Margin"
                                Value="8,0,8,16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="PreviewUrl"
                   IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                   Text="{x:Bind ClipData.Data, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <Grid x:Name="PreviewGrid"
              x:Load="{x:Bind LinkMetadata, Mode=OneWay, Converter={StaticResource EmptyObjectToBoolConverter}}"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <!-- Reserved for ExpandedView visual state -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="PreviewImageBorder"
                    Visibility="Collapsed">
                <Image x:Name="PreviewImage"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ImageOpened="PreviewImage_ImageOpened"
                       Source="{x:Bind ImageSource, Mode=OneWay}" />
            </Border>

            <TextBlock x:Name="PreviewTitle"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                       Text="{x:Bind LinkMetadata.Title, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBlock x:Name="PreviewDescription"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                       Text="{x:Bind LinkMetadata.Description, Mode=OneWay}"
                       Visibility="{x:Bind PreviewDescription.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </Grid>
    </StackPanel>
</local:DataPreviewBase>
