<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Rememory.Views.Clipboard.Controls.ClipsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Rememory.Views.Clipboard.Controls"
             xmlns:models="using:Rememory.Models"
             xmlns:tk="using:CommunityToolkit.WinUI"
             xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
             xmlns:converters="using:Rememory.Converters"
             xmlns:controls="using:Rememory.Views.Clipboard.Controls"
             xmlns:behavior="using:Rememory.Views.Clipboard.Controls.Behavior"
             xmlns:selector="using:Rememory.Views.Clipboard.Controls.Selector"
             x:Name="RootControl"
             Unloaded="RootControl_Unloaded">
    <UserControl.Resources>
        <converters:ClipDataDictionaryToDataConverter x:Key="ClipDataDictionaryToDataConverter" />
        <converters:DateTimeToHumanReadableConverter x:Key="DateTimeToHumanReadableConverter" />
        <converters:DataFooterInfoConverter x:Key="DataFooterInfoConverter" />

        <selector:ClipPreviewTemplateSelector x:Key="ClipPreviewTemplateSelector">
            <selector:ClipPreviewTemplateSelector.TextTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:TextPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                          SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.TextTemplate>

            <selector:ClipPreviewTemplateSelector.LinkTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:LinkPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                          SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.LinkTemplate>

            <selector:ClipPreviewTemplateSelector.ImageTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:ImagePreview CornerRadius="{ThemeResource ControlCornerRadius}"
                                           ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.ImageTemplate>

            <selector:ClipPreviewTemplateSelector.FilesTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:FilesPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.FilesTemplate>

            <selector:ClipPreviewTemplateSelector.ColorTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:ColorPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.ColorTemplate>

            <selector:ClipPreviewTemplateSelector.EmptyTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:EmptyPreview />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.EmptyTemplate>
        </selector:ClipPreviewTemplateSelector>

        <selector:ClipPreviewTemplateSelector x:Name="ClipCompactPreviewTemplateSelector"
                                              x:Key="ClipCompactPreviewTemplateSelector">
            <selector:ClipPreviewTemplateSelector.TextTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:TextPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                          SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}"
                                          PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.TextTemplate>

            <selector:ClipPreviewTemplateSelector.LinkTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:LinkPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                          SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}"
                                          PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.LinkTemplate>

            <selector:ClipPreviewTemplateSelector.ImageTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:ImagePreview CornerRadius="{ThemeResource ControlCornerRadius}"
                                           ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}"
                                           PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.ImageTemplate>

            <selector:ClipPreviewTemplateSelector.FilesTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:FilesPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}"
                                           PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.FilesTemplate>

            <selector:ClipPreviewTemplateSelector.ColorTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:ColorPreview ClipData="{x:Bind Data, Converter={StaticResource ClipDataDictionaryToDataConverter}, Mode=OneWay}"
                                           SearchText="{Binding DataContext.SearchString, ElementName=ClipsList}"
                                           PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.ColorTemplate>

            <selector:ClipPreviewTemplateSelector.EmptyTemplate>
                <DataTemplate x:DataType="models:ClipModel">
                    <controls:EmptyPreview PreviewVisualState="Compact" />
                </DataTemplate>
            </selector:ClipPreviewTemplateSelector.EmptyTemplate>
        </selector:ClipPreviewTemplateSelector>

        <DataTemplate x:Key="ClipLayoutTemplate"
                      x:DataType="models:ClipModel"
                      x:DefaultBindMode="OneWay">
            <Grid x:Name="ClipRootGrid"
                  Padding="12"
                  CornerRadius="{ThemeResource ListViewItemCornerRadius}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  ContextRequested="ClipRootGrid_ContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PreviewPresenter"
                                Grid.Column="0"
                                Grid.Row="0"
                                Grid.ColumnSpan="4"
                                Margin="0,0,0,8"
                                IsTabStop="False"
                                IsHitTestVisible="False"
                                HorizontalContentAlignment="Stretch"
                                Content="{x:Bind}"
                                ContentTemplateSelector="{StaticResource ClipPreviewTemplateSelector}" />

                <ListView x:Name="ClipTagsListView"
                          x:Load="{x:Bind HasTags}"
                          Grid.Column="0"
                          Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Margin="0,0,0,8"
                          SelectionMode="None"
                          IsHitTestVisible="False"
                          ItemsSource="{x:Bind Tags}"
                          ItemTemplate="{StaticResource TagPreviewTemplate}">
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListView">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Style>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <tkcontrols:WrapPanel Orientation="Horizontal"
                                                  HorizontalSpacing="4"
                                                  VerticalSpacing="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="IsTabStop"
                                    Value="False" />
                            <Setter Property="MinWidth"
                                    Value="30" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                            <Setter Property="MaxWidth"
                                    Value="120" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <FontIcon x:Name="ClipFavoriteIcon"
                          x:Load="{x:Bind IsFavorite}"
                          Grid.Column="0"
                          Grid.Row="2"
                          Margin="0,0,8,0"
                          Glyph="&#xE735;"
                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                          FontSize="{StaticResource CaptionTextBlockFontSize}" />

                <TextBlock Grid.Column="1"
                           Grid.Row="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionTextBlockFontSize}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           DataContext="{x:Bind Data, Converter={StaticResource DataFooterInfoConverter}}"
                           Text="{Binding Result}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           Grid.Row="2"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ClipTime, Converter={StaticResource DateTimeToHumanReadableConverter}}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <Image x:Name="ClipIconBitmap"
                       x:Load="{x:Bind Owner.IconBitmap, Converter={StaticResource EmptyObjectToBoolConverter}}"
                       Grid.Column="3"
                       Grid.Row="2"
                       Height="16"
                       Margin="8,0,0,0"
                       Source="{x:Bind Owner.IconBitmap}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactClipLayoutTemplate"
                      x:DataType="models:ClipModel"
                      x:DefaultBindMode="OneWay">
            <Grid x:Name="ClipRootGrid"
                  Padding="8"
                  CornerRadius="{ThemeResource ListViewItemCornerRadius}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderThickness="{ThemeResource ButtonBorderThemeThickness}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  ContextRequested="ClipRootGrid_ContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ToolTipService.ToolTip>
                    <ToolTip Padding="-2"
                             IsEnabled="{Binding ViewModel.SettingsContext.IsClipHoverPreviewInCompactViewEnabled, ElementName=RootControl}">
                        <ContentControl Content="{x:Bind}"
                                        ContentTemplate="{StaticResource ClipLayoutTemplate}" />
                    </ToolTip>
                </ToolTipService.ToolTip>

                <ContentControl x:Name="PreviewPresenter"
                                Grid.Column="0"
                                Grid.Row="0"
                                Grid.ColumnSpan="5"
                                Margin="0,0,0,4"
                                IsTabStop="False"
                                IsHitTestVisible="False"
                                HorizontalContentAlignment="Stretch"
                                Content="{x:Bind}"
                                ContentTemplateSelector="{StaticResource ClipCompactPreviewTemplateSelector}" />

                <FontIcon x:Name="ClipFavoriteIcon"
                          x:Load="{x:Bind IsFavorite}"
                          Grid.Column="0"
                          Grid.Row="1"
                          Margin="0,0,8,0"
                          Glyph="&#xE735;"
                          Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                          FontSize="{StaticResource CaptionTextBlockFontSize}" />

                <ListView x:Name="ClipTagsListView"
                          x:Load="{x:Bind HasTags}"
                          Grid.Column="1"
                          Grid.Row="1"
                          Margin="0,0,8,0"
                          SelectionMode="None"
                          ItemsSource="{x:Bind Tags}"
                          IsHitTestVisible="False">
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListView">
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Style>

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="IsTabStop"
                                    Value="False" />
                            <Setter Property="MinWidth"
                                    Value="10" />
                            <Setter Property="MinHeight"
                                    Value="10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TagModel">
                            <Grid Width="10"
                                  Height="10"
                                  CornerRadius="5"
                                  Background="{x:Bind ColorBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="ClipFooter"
                           Grid.Column="2"
                           Grid.Row="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionTextBlockFontSize}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           DataContext="{x:Bind Data, Converter={StaticResource DataFooterInfoConverter}}"
                           Text="{Binding Result}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="3"
                           Grid.Row="1"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ClipTime, Converter={StaticResource DateTimeToHumanReadableConverter}}"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <Image x:Name="ClipIconBitmap"
                       x:Load="{x:Bind Owner.IconBitmap, Converter={StaticResource EmptyObjectToBoolConverter}}"
                       Grid.Column="4"
                       Grid.Row="1"
                       Height="16"
                       Margin="8,0,0,0"
                       Source="{x:Bind Owner.IconBitmap}" />
            </Grid>
        </DataTemplate>

        <MenuFlyout x:Key="SingleClipContextMenu"
                    x:DefaultBindMode="OneWay">
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_AddToFavorites"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.ToggleClipFavoriteCommand}"
                            IsEnabled="{Binding IsFavorite, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE734;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_RemoveFromFavorites"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.ToggleClipFavoriteCommand}"
                            IsEnabled="{Binding IsFavorite}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE8D9;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_OpenInBrowser"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xF6FA;}" />
            <MenuFlyoutItem x:Name="OpenClipInFlyoutMenuFlyoutItem"
                            x:Uid="/Clipboard/Clip_ContextMenu_OpenInFlyout"
                            KeyboardAcceleratorTextOverride="Space"
                            Click="OpenInFlyoutItem_Click"
                            Icon="{tk:FontIcon Glyph=&#xE8A7;}" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="PasteClipMenuFlyoutItem"
                            x:Uid="/Clipboard/Clip_ContextMenu_Paste"
                            KeyboardAcceleratorTextOverride="Enter"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.PasteClipCommand}"
                            Icon="{tk:FontIcon Glyph=&#xE77F;}" />
            <MenuFlyoutSubItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs"
                               Icon="{tk:FontIcon Glyph=&#xE8D2;}"
                               behavior:MenuFlyoutBehavior.AutoDisable="True"
                               Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuFlyoutItem x:Name="PasteAsPlainTextMenuFlyoutItem"
                                x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_PlainText"
                                KeyboardAcceleratorTextOverride="Shift+Enter"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipAsPlainTextCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_UpperCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithUpperCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_LowerCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithLowerCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_CapitalizedCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithCapitalizedCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_SentenceCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithSentenceCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_InvertCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithInvertCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_TrimWhitespace"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithTrimWhitespaceCommand}" />
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.SettingsContext.IsDeveloperStringCaseConversionsEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_CamelCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithCamelCaseCommand}"
                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_PascalCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithPascalCaseCommand}"
                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_SnakeCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithSnakeCaseCommand}"
                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_KebabCase"
                                CommandParameter="{Binding}"
                                Command="{x:Bind ViewModel.PasteClipWithKebabCaseCommand}"
                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Copy"
                            KeyboardAcceleratorTextOverride="Ctrl+C"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.CopyClipCommand}"
                            Icon="{tk:FontIcon Glyph=&#xE8C8;}" />
            <MenuFlyoutSubItem x:Uid="/Clipboard/Clip_ContextMenu_SaveAs"
                               Icon="{tk:FontIcon Glyph=&#xE74E;}"
                               Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                               Loaded="MenuFlyoutSaveClip_Loaded" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Edit"
                            KeyboardAcceleratorTextOverride="Ctrl+U"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.EditClipCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE70F;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Export"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.ExportClipCommand}"
                            Icon="{tk:FontIcon Glyph=&#xEDE2;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Delete"
                            KeyboardAcceleratorTextOverride="Shift+Delete"
                            CommandParameter="{Binding}"
                            Command="{x:Bind ViewModel.DeleteClipCommand}"
                            Icon="{tk:FontIcon Glyph=&#xE74D;}" />
            <MenuFlyoutSeparator x:Name="ClipMenuFlyoutBottomSeparator" />
            <MenuFlyoutSubItem x:Name="TagsClipMenuFlyoutItem"
                               x:Uid="/Clipboard/Clip_ContextMenu_Tags"
                               Icon="{tk:FontIcon Glyph=&#xE8EC;}"
                               Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                               Loaded="MenuFlyoutTags_Loaded" />
            <MenuFlyoutItem x:Name="FilterClipMenuFlyoutItem"
                            x:Uid="/Clipboard/Clip_ContextMenu_FilterSource"
                            CommandParameter="{Binding Owner}"
                            Command="{x:Bind ViewModel.AddOwnerToFiltersCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE71C;}" />
        </MenuFlyout>

        <MenuFlyout x:Key="MultipleClipsContextMenu"
                    x:DefaultBindMode="OneWay">
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_AddToFavorites"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.AddClipsToFavoritesCommand}"
                            IsEnabled="{Binding IsFavorite, Converter={StaticResource BoolNegationConverter}}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE734;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_RemoveFromFavorites"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RemoveClipsFromFavoritesCommand}"
                            IsEnabled="{Binding IsFavorite}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE8D9;}" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="PasteClipsMenuFlyoutItem"
                            x:Uid="/Clipboard/Clip_ContextMenu_Paste"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.PasteClipsCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE77F;}" />
            <MenuFlyoutSubItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs"
                               Icon="{tk:FontIcon Glyph=&#xE8D2;}"
                               IsEnabled="{Binding IsEnabled, ElementName=PasteClipsMenuFlyoutItem}"
                               Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_UpperCase"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithUpperCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_LowerCase"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithLowerCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_CapitalizedCase"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithCapitalizedCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_SentenceCase"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithSentenceCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_InvertCase"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithInvertCaseCommand}" />
                <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_PasteAs_TrimWhitespace"
                                CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PasteClipsWithTrimWhitespaceCommand}" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Copy"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopyClipsCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE8C8;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Export"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ExportClipsCommand}"
                            Icon="{tk:FontIcon Glyph=&#xEDE2;}" />
            <MenuFlyoutItem x:Uid="/Clipboard/Clip_ContextMenu_Delete"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.DeleteClipsCommand}"
                            Icon="{tk:FontIcon Glyph=&#xE74D;}" />
            <MenuFlyoutSeparator x:Name="ClipsMenuFlyoutBottomSeparator" />
            <MenuFlyoutSubItem x:Name="TagsClipsMenuFlyoutItem"
                               x:Uid="/Clipboard/Clip_ContextMenu_Tags"
                               Icon="{tk:FontIcon Glyph=&#xE8EC;}"
                               Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                               Loaded="MenuFlyoutTags_Loaded" />
            <MenuFlyoutItem x:Name="FilterClipsMenuFlyoutItem"
                            x:Uid="/Clipboard/Clip_ContextMenu_FilterSource"
                            CommandParameter="{x:Bind OrderedSelectedClips, Mode=OneWay}"
                            Command="{x:Bind ViewModel.AddOwnersToFiltersCommand}"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Icon="{tk:FontIcon Glyph=&#xE71C;}" />
        </MenuFlyout>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NoneSelectionMode">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind ClipsList.SelectionMode, Mode=OneWay}"
                                                To="None" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MultipleSelectionFooter.Visibility"
                                Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="MultipleSelectionMode">
                    <VisualState.StateTriggers>
                        <tk:IsEqualStateTrigger Value="{x:Bind ClipsList.SelectionMode, Mode=OneWay}"
                                                To="Multiple" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MultipleSelectionFooter.Visibility"
                                Value="Visible" />
                        <!-- User can see single context menu in multiple selection mode,
                             so we should hide keyboard accelerator text a for few menu items to avoid conflicts -->
                        <Setter Target="OpenClipInFlyoutMenuFlyoutItem.KeyboardAcceleratorTextOverride"
                                Value="" />
                        <Setter Target="PasteClipMenuFlyoutItem.KeyboardAcceleratorTextOverride"
                                Value="" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="EmptyListInfoPanel"
                    x:DefaultBindMode="OneWay"
                    Grid.Row="0"
                    MaxWidth="300"
                    Margin="16 0 24 36"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon x:Name="EmptyListTabPreview"
                      x:Load="{x:Bind ViewModel.SelectedTab.IsTag, Converter={StaticResource BoolNegationConverter}}"
                      FontSize="24"
                      Glyph="{x:Bind ViewModel.SelectedTab.BigGlyph}" />

            <ContentControl x:Name="EmptyListTagPreview"
                            x:Load="{x:Bind ViewModel.SelectedTab.IsTag}"
                            HorizontalAlignment="Center"
                            Content="{x:Bind ViewModel.SelectedTab.Tag}"
                            ContentTemplate="{StaticResource TagPreviewTemplate}" />

            <TextBlock TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.SelectedTab.EmptyListMessage}" />
        </StackPanel>

        <ListView x:Name="ClipsList"
                  Grid.Row="0"
                  AutomationProperties.AutomationId="ClipsList"
                  AutomationProperties.Name="All Clips"
                  SelectionMode="{x:Bind SelectionMode, Mode=OneWay}"
                  ShowsScrollingPlaceholders="False"
                  IsItemClickEnabled="True"
                  CanDragItems="{x:Bind ViewModel.SettingsContext.IsClipsDragAndDropEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.ClipsCollection, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource ClipsListViewStyle}"
                  ItemTemplate="{StaticResource ClipLayoutTemplate}"
                  PreviewKeyDown="ClipsList_PreviewKeyDown"
                  PreviewKeyUp="ClipsList_PreviewKeyUp"
                  ContainerContentChanging="ClipsList_ContainerContentChanging"
                  ItemClick="ClipsList_ItemClick"
                  GettingFocus="ClipsList_GettingFocus"
                  DragItemsStarting="ClipsList_DragItemsStarting"
                  SelectionChanged="ClipsList_SelectionChanged" />

        <Grid x:Name="MultipleSelectionFooter"
              Grid.Row="1"
              Height="32"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectedClipsCountTextBlock"
                       Grid.Column="0"
                       Margin="8,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />

            <CheckBox x:Name="SelectAllCheckBox"
                      x:Uid="/Clipboard/SelectAllClips"
                      Grid.Column="1"
                      MinWidth="20"
                      MinHeight="20"
                      Margin="0,0,16,0"
                      Padding="0"
                      VerticalAlignment="Center"
                      Click="SelectAllCheckBox_Click" />
        </Grid>
    </Grid>
</UserControl>
