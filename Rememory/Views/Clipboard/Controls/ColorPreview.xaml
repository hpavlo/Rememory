<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.ColorPreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       xmlns:mui="using:Microsoft.UI"
                       x:Name="ParentControl"
                       Loaded="ParentControl_Loaded">
    <local:DataPreviewBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DefaultThemeBackgroundBrush"
                                     Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DefaultThemeBackgroundBrush"
                                     Color="Black" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </local:DataPreviewBase.Resources>

    <Grid x:Name="RootGrid"
          ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactView">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.ColumnSpacing"
                                Value="8" />
                        <Setter Target="ColorGrid.Width"
                                Value="16" />
                        <Setter Target="ColorGrid.Height"
                                Value="16" />
                        <Setter Target="ColorGrid.CornerRadius"
                                Value="2" />
                        <Setter Target="ColorGridPath.Width"
                                Value="16" />
                        <Setter Target="ColorGridPath.Height"
                                Value="16" />
                        <Setter Target="ColorGridPath.Data"
                                Value="M0,0h8v8H0z M8,8h8v8H8z" />
                        <Setter Target="ColorCodeTextBlock.FontSize"
                                Value="{StaticResource CompactViewTextFontSize}" />
                        <Setter Target="ColorCodeTextBlock.(Grid.RowSpan)"
                                Value="2" />
                        <Setter Target="ColorNameTextBlock.Visibility"
                                Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Default visual state -->
                <VisualState x:Name="StandardView" />

                <VisualState x:Name="ExpandedView">
                    <VisualState.Setters>
                        <Setter Target="ColorCodeTextBlock.FontSize"
                                Value="{StaticResource ExpandedViewTextFontSize}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ColorGrid"
              Grid.Column="0"
              Grid.RowSpan="2"
              Width="32"
              Height="32"
              CornerRadius="3"
              Background="{ThemeResource DefaultThemeBackgroundBrush}">
            <Path x:Name="ColorGridPath"
                  Width="32"
                  Height="32"
                  Stroke="Transparent"
                  Fill="#60888888"
                  Data="M0,0h8v8H0z M8,8h8v8H8z M16,16h8v8h-8z M24,24h8v8h-8z M16,0h8v8h-8z M24,8h8v8h-8z M0,16h8v8H0z M8,24h8v8H8z" />

            <Border>
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}" />
                </Border.Background>
            </Border>
        </Grid>

        <TextBlock x:Name="ColorCodeTextBlock"
                   Grid.Column="1"
                   Grid.Row="0"
                   MaxLines="1"
                   FontSize="{StaticResource StandardViewTextFontSize}"
                   IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                   Text="{x:Bind ClipData.Data.Trim(), Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <TextBlock x:Name="ColorNameTextBlock"
                   Grid.Column="1"
                   Grid.Row="1"
                   MaxLines="2"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                   Text="{x:Bind mui:ColorHelper.ToDisplayName(Color), Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <Grid x:Name="AllFormatsPerwiewGrid"
              x:Load="{x:Bind IsAllFarmatsAvailable}"
              x:DefaultBindMode="OneWay"
              Grid.ColumnSpan="2"
              Grid.Row="2"
              Margin="0,8,0,0"
              ColumnSpacing="12"
              RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0"
                       Grid.Row="0"
                       Text="HEX" />
            <TextBlock Grid.Column="0"
                       Grid.Row="1"
                       Text="RGB" />
            <TextBlock Grid.Column="0"
                       Grid.Row="2"
                       Text="RGBA" />
            <TextBlock Grid.Column="0"
                       Grid.Row="3"
                       Text="HSL" />
            <TextBlock Grid.Column="0"
                       Grid.Row="4"
                       Text="HSLA" />

            <TextBlock Grid.Column="1"
                       Grid.Row="0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled}"
                       Text="{x:Bind HexColor}" />
            <TextBlock Grid.Column="1"
                       Grid.Row="1"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled}"
                       Text="{x:Bind RgbColor}" />
            <TextBlock Grid.Column="1"
                       Grid.Row="2"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled}"
                       Text="{x:Bind RgbaColor}" />
            <TextBlock Grid.Column="1"
                       Grid.Row="3"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled}"
                       Text="{x:Bind HslColor}" />
            <TextBlock Grid.Column="1"
                       Grid.Row="4"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled}"
                       Text="{x:Bind HslaColor}" />
        </Grid>
    </Grid>
</local:DataPreviewBase>
