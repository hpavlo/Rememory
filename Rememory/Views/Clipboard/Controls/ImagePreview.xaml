<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.ImagePreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       x:Name="ParentControl"
                       MaxHeight="120">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactView">
                    <VisualState.Setters>
                        <Setter Target="ParentControl.MaxHeight"
                                Value="32" />

                        <Setter Target="PreviewImage.Stretch"
                                Value="UniformToFill" />
                        <Setter Target="PreviewImage.HorizontalAlignment"
                                Value="Center" />
                        <Setter Target="PreviewImage.VerticalAlignment"
                                Value="Center" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Default visual state -->
                <VisualState x:Name="StandardView" />

                <VisualState x:Name="ExpandedView">
                    <VisualState.Setters>
                        <Setter Target="ParentControl.MaxHeight"
                                Value="100000" />

                        <Setter Target="PreviewImage.Stretch"
                                Value="Uniform" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               Source="{x:Bind ClipData.Data, Mode=OneWay}" />
    </Grid>
</local:DataPreviewBase>
