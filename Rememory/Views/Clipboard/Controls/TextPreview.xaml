<?xml version="1.0" encoding="utf-8"?>
<local:DataPreviewBase x:Class="Rememory.Views.Clipboard.Controls.TextPreview"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="using:Rememory.Views.Clipboard.Controls"
                       Loaded="ParentControl_Loaded">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactView">
                    <VisualState.Setters>
                        <Setter Target="PreviewTextBlock.FontSize"
                                Value="{StaticResource CompactViewTextFontSize}" />
                        <Setter Target="PreviewTextBlock.MaxLines"
                                Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Default visual state -->
                <VisualState x:Name="StandardView" />

                <VisualState x:Name="ExpandedView">
                    <VisualState.Setters>
                        <Setter Target="PreviewTextBlock.FontSize"
                                Value="{StaticResource ExpandedViewTextFontSize}" />
                        <Setter Target="PreviewTextBlock.MaxLines"
                                Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="PreviewTextBlock"
                   MaxLines="6"
                   FontSize="{StaticResource StandardViewTextFontSize}"
                   IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneWay}"
                   Text="{x:Bind DataPreview, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}" />
    </Grid>
</local:DataPreviewBase>
