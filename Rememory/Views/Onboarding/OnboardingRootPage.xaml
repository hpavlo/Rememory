<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Rememory.Views.Onboarding.OnboardingRootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Rememory.Views.Onboarding"
      xmlns:tk="using:CommunityToolkit.WinUI"
      xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
      xmlns:settingsControls="using:Rememory.Views.Settings.Controls"
      xmlns:shortcut="using:Rememory.Views.Settings.Controls.Shortcut"
      xmlns:converters="using:Rememory.Converters"
      DataContext="{x:Bind ViewModel}"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Page.Resources>
        <converters:EnumToIndexConverter x:Key="EnumToIndexConverter" />
    </Page.Resources>

    <Grid Margin="36,40,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Image Height="48"
                   Source="ms-appx:///Assets/AppList.png" />

            <TextBlock x:Uid="/Settings/Onboarding_Title"
                       TextAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Style="{StaticResource TitleLargeTextBlockStyle}" />

            <TextBlock x:Uid="/Settings/Onboarding_Subtitle"
                       TextAlignment="Center"
                       Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                       Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Uid="/Settings/Onboarding_SettingsHeader"
                           Margin="0,0,0,12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource BodyTextBlockStyle}" />

                <tkcontrols:SettingsCard x:Uid="/Settings/General_RunAtStartup"
                                         Margin="0,0,0,3"
                                         HeaderIcon="{tk:FontIcon Glyph=&#xF103;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RunAtStartupToggle, Mode=TwoWay}" />
                </tkcontrols:SettingsCard>

                <tkcontrols:SettingsCard x:Uid="/Settings/Personalization_AppTheme"
                                         Margin="0,0,0,3"
                                         HeaderIcon="{tk:FontIcon Glyph=&#xE790;}">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SettingsContext.Theme, Mode=TwoWay, Converter={StaticResource EnumToIndexConverter}}">
                        <ComboBoxItem x:Uid="/Settings/Personalization_AppTheme_Default" />
                        <ComboBoxItem x:Uid="/Settings/Personalization_AppTheme_Light" />
                        <ComboBoxItem x:Uid="/Settings/Personalization_AppTheme_Dark" />
                    </ComboBox>
                </tkcontrols:SettingsCard>

                <tkcontrols:SettingsCard x:Uid="/Settings/General_ActivationShortcut"
                                         HeaderIcon="{tk:FontIcon Glyph=&#xEDA7;}">
                    <shortcut:ShortcutButton ActivationShortcut="{x:Bind ViewModel.SettingsContext.ActivationShortcut, Mode=TwoWay}"
                                             ActivationShortcutDefault="{x:Bind ViewModel.SettingsContext.ActivationShortcutDefault, Mode=OneWay}" />
                </tkcontrols:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <InfoBar x:Uid="/Settings/Onboarding_QuickTipInfo"
                     Margin="0,0,0,24"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />

            <Button x:Uid="/Settings/Onboarding_GetStartedButton"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="GetStartedButton_Click" />
        </StackPanel>
    </Grid>
</Page>
