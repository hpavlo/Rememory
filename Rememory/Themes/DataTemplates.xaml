<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary x:Class="Rememory.Themes.DataTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:Rememory.Models">
    <DataTemplate x:Key="TabItemTemplate"
                  x:DataType="models:TabItemModel"
                  x:DefaultBindMode="OneWay">
        <NavigationViewItem AccessKey="{x:Bind AccessKey}"
                            Content="{x:Bind Title}">
            <NavigationViewItem.Icon>
                <FontIcon Glyph="{x:Bind Glyph}" />
            </NavigationViewItem.Icon>
        </NavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="TagTabItemTemplate"
                  x:DataType="models:TabItemModel"
                  x:DefaultBindMode="OneWay">
        <NavigationViewItem Content="{x:Bind Tag.Name}">
            <NavigationViewItem.Icon>
                <FontIcon Glyph="{x:Bind Glyph}"
                          Foreground="{x:Bind Tag.ColorBrush}" />
            </NavigationViewItem.Icon>
        </NavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="TagPreviewTemplate"
                  x:DataType="models:TagModel"
                  x:DefaultBindMode="OneWay">
        <Grid Padding="8,2,8,4"
              CornerRadius="10"
              Background="{x:Bind ColorBrush}">
            <TextBlock FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="{x:Bind Name}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AppTreeViewNodeTemplate"
                  x:DataType="models:AppTreeViewNode"
                  x:DefaultBindMode="OneWay">
        <TreeViewItem CanDrag="False"
                      ItemsSource="{x:Bind Children}"
                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind OwnerPath}">
            <Grid Margin="-28,0,8,0"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Width="20"
                       Height="20"
                       Source="{x:Bind Image}" />

                <TextBlock Grid.Column="1"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind Title}" />
            </Grid>
        </TreeViewItem>
    </DataTemplate>
</ResourceDictionary>
